# Server
PORT=3001
# SQLite file (relative paths resolve from the repo root). Created on first run.
DB_PATH=server/data/studyrevr.db
MAX_UPLOAD_MB=20

# AI provider: any OpenAI-compatible /v1/chat/completions endpoint.
# Values saved in Settings override these. Examples:
#   NVIDIA NIM  AI_BASE_URL=https://integrate.api.nvidia.com/v1
#   Ollama      AI_BASE_URL=http://localhost:11434/v1   (no key needed)
#   OpenRouter  AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Optional tuning
# AI_TIMEOUT_SECONDS=300   per request; raise it for slow local models
# AI_CHUNK_TOKENS=2400     lesson text per AI call (the default suits ~8k-context models)
