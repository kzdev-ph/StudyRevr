# Server
PORT=3001
# SQLite file (relative paths resolve from the repo root). Created on first run. It can hold API keys saved in
# Settings, so it is git-ignored: never commit it.
DB_PATH=server/data/studyrevr.db
MAX_UPLOAD_MB=20

# --- AI provider -------------------------------------------------------------------------------------------------
# Every provider speaks the OpenAI-compatible /chat/completions API. Pick one; Settings can switch it later (values
# saved in Settings override this file, and each provider remembers its own model and key).
#   google      Google Gemini (default; free tier ~15 requests/minute)   key: GOOGLE_API_KEY
#   nvidia-nim  NVIDIA NIM                                               key: NVIDIA_API_KEY
#   openrouter  OpenRouter                                               key: OPENROUTER_API_KEY
#   ollama      local Ollama (no key)       llamacpp  local llama.cpp server (no key)
#   custom      any other OpenAI-compatible server: set AI_BASE_URL (and AI_API_KEY if it wants one)
AI_PROVIDER=google

# One key per provider; only the active provider's key is ever sent. Placeholders: put your own keys here.
GOOGLE_API_KEY=your-google-ai-studio-key
NVIDIA_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides for the provider above (leave empty to use the preset's URL and default model).
# The model id is free text; Settings lists the provider's models (GET /api/settings/models).
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Optional: a JSON object merged into every chat request, for provider options such as turning thinking off.
# Ignored (with a warning) if it is not a JSON object. Applies to the provider above only. Example:
# AI_EXTRA_BODY={"reasoning_effort":"none"}
AI_EXTRA_BODY=

# Optional tuning (defaults come from the provider preset)
# AI_CONCURRENCY=2         parallel AI calls within one stage of a lesson (google 2, nvidia-nim 2, openrouter 2, local 1)
# AI_CHUNK_TOKENS=30000    lesson text per AI call (google 30000; the others 2400, which suits ~8k-context models)
# AI_TIMEOUT_SECONDS=300   per request; raise it for slow local models
# KEY_TERMS_MAX=12         key terms kept per lesson
